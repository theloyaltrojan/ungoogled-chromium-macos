+void SidePanel::HandleTabDrop(TabDragTarget::DragController& controller) {
+  can_drop_tab_ = false;
+  TabStripModel* const model = browser_view_->browser()->GetTabStripModel();
+
+  // Remember where each dragged tab came from before detaching: tabs dragged
+  // as part of a whole group (header drag) keep that group; single tabs become
+  // loose side tabs.
+  struct Dropped {
+    std::unique_ptr<tabs::TabModel> tab;
+    std::optional<tab_groups::TabGroupId> from_group;
+    std::optional<tab_groups::TabGroupVisualData> visuals;
+  };
+  std::vector<Dropped> dropped;
+  {
+    const DragSessionData& data = controller.GetSessionData();
+    for (size_t i = 0; i < data.tab_drag_data_.size(); ++i) {
+      const TabDragData& d = data.tab_drag_data_[i];
+      if (d.view_type != TabSlotView::ViewType::kTab || !d.contents) {
+        continue;  // group headers aren't tabs
+      }
+      Dropped item;
+      if (d.tab_group_data.has_value() &&
+          data.dragging_groups.contains(d.tab_group_data->group_id)) {
+        item.from_group = d.tab_group_data->group_id;
+        item.visuals = d.tab_group_data->group_visual_data;
+      }
+      dropped.push_back(std::move(item));
+    }
+    // Detach after collecting (detaching may close the drag window).
+    size_t n = 0;
+    for (size_t i = 0; i < data.tab_drag_data_.size(); ++i) {
+      const TabDragData& d = controller.GetSessionData().tab_drag_data_[i];
+      if (d.view_type != TabSlotView::ViewType::kTab || !d.contents) {
+        continue;
+      }
+      dropped[n++].tab = controller.DetachTabAtForInsertion(static_cast<int>(i));
+    }
+  }
+
+  auto find_loose_group = [&]() -> std::optional<tab_groups::TabGroupId> {
+    for (const tab_groups::TabGroupId& id :
+         model->group_model()->ListTabGroups()) {
+      if (model->group_model()->GetTabGroup(id)->visual_data()->title() ==
+          kSideTabsGroupTitle) {
+        return id;
+      }
+    }
+    return std::nullopt;
+  };
+
+  std::map<tab_groups::TabGroupId, tab_groups::TabGroupId> new_groups;
+  std::optional<int> first;
+  for (Dropped& item : dropped) {
+    if (!item.tab) {
+      continue;
+    }
+    std::optional<tab_groups::TabGroupId> group;
+    std::u16string title;
+    tab_groups::TabGroupColorId color = tab_groups::TabGroupColorId::kPurple;
+    if (item.from_group.has_value()) {
+      auto it = new_groups.find(*item.from_group);
+      if (it != new_groups.end()) {
+        group = it->second;
+      }
+      title = std::u16string(kSideTabsNamedGroupPrefix) + item.visuals->title();
+      color = item.visuals->color();
+    } else {
+      group = find_loose_group();
+      title = kSideTabsGroupTitle;
+    }
+    const int index =
+        group.has_value()
+            ? static_cast<int>(
+                  model->group_model()->GetTabGroup(*group)->ListTabs().end())
+            : model->count();
+    const int at = model->InsertDetachedTabAt(index, std::move(item.tab),
+                                              AddTabTypes::ADD_NONE, group);
+    if (!group.has_value()) {
+      group = model->AddToNewGroup({at});
+      model->ChangeTabGroupVisuals(
+          *group, tab_groups::TabGroupVisualData(title, color,
+                                                 /*is_collapsed=*/false));
+      if (item.from_group.has_value()) {
+        new_groups.emplace(*item.from_group, *group);
+      }
+    }
+    if (!first.has_value()) {
+      first = at;
+    }
+  }
+  if (first.has_value()) {
+    model->ActivateTabAt(*first);
+  }
+}
