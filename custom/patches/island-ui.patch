# Island UI: pill-shaped tabs (active tab no longer flares into the toolbar)
# and a toolbar with rounded corners floating on the frame color.
# chrome://flags: #island-classic-tabs, #island-toolbar-radius.
diff --git a/chrome/browser/ui/views/tabs/common/horizontal_tab_style_views.cc b/chrome/browser/ui/views/tabs/common/horizontal_tab_style_views.cc
index 5e8bf77..5b2d224 100644
--- a/chrome/browser/ui/views/tabs/common/horizontal_tab_style_views.cc
+++ b/chrome/browser/ui/views/tabs/common/horizontal_tab_style_views.cc
@@ -8,6 +8,7 @@
 #include <cmath>
 #include <utility>
 
+#include "base/command_line.h"
 #include "base/i18n/rtl.h"
 #include "base/memory/raw_ptr.h"
 #include "base/numerics/safe_conversions.h"
@@ -89,8 +90,15 @@ SkPath HorizontalTabStyleViews::GetPath(TabStyle::PathType path_type,
                                   scale;
 
   // Selected, hover, and inactive tab fills are a detached squarcle tab.
+  // [custom] Island: the active tab and its border are detached pills too,
+  // instead of the file-folder shape that flares into the toolbar.
+  // chrome://flags/#island-classic-tabs turns this off.
+  const bool island_tabs = !base::CommandLine::ForCurrentProcess()->HasSwitch(
+      "island-classic-tabs");
   if (path_type == TabStyle::PathType::kHighlight ||
-      path_type == TabStyle::PathType::kHitTest) {
+      path_type == TabStyle::PathType::kHitTest ||
+      (island_tabs && (path_type == TabStyle::PathType::kActiveTab ||
+                       path_type == TabStyle::PathType::kBorder))) {
     float top_left_corner_radius = content_corner_radius;
     float top_right_corner_radius = content_corner_radius;
     float bottom_left_corner_radius = content_corner_radius;
@@ -164,6 +172,15 @@ SkPath HorizontalTabStyleViews::GetPath(TabStyle::PathType path_type,
       }
     }
 
+    // [custom] Island: fully rounded (pill) ends on every rounded corner.
+    const float pill_radius = std::min(bottom - top, right - left) / 2.0f;
+    for (float* r : {&top_left_corner_radius, &top_right_corner_radius,
+                     &bottom_right_corner_radius, &bottom_left_corner_radius}) {
+      if (island_tabs && *r > 0) {
+        *r = std::max(*r, pill_radius);
+      }
+    }
+
     // Radii are clockwise from top left.
     const SkVector radii[4] = {
         SkVector(top_left_corner_radius, top_left_corner_radius),
diff --git a/chrome/browser/ui/views/toolbar/toolbar_view.cc b/chrome/browser/ui/views/toolbar/toolbar_view.cc
index 7c8da2f..882c627 100644
--- a/chrome/browser/ui/views/toolbar/toolbar_view.cc
+++ b/chrome/browser/ui/views/toolbar/toolbar_view.cc
@@ -9,6 +9,7 @@
 #include <utility>
 
 #include "base/command_line.h"
+#include "base/strings/string_number_conversions.h"
 #include "base/containers/fixed_flat_map.h"
 #include "base/feature_list.h"
 #include "base/functional/bind.h"
@@ -365,10 +366,33 @@ void ToolbarView::Init() {
   }
 
   if (display_mode_ == DisplayMode::kNormal) {
-    SetBackground(std::make_unique<CustomCornersBackground>(
+    // [custom] Island: the toolbar is a rounded slab sitting on the frame
+    // color, so it reads as a floating bar rather than part of the window.
+    // chrome://flags/#island-toolbar-radius picks the corner radius.
+    int island_radius = 14;
+    const base::CommandLine& island_cl = *base::CommandLine::ForCurrentProcess();
+    if (int parsed; island_cl.HasSwitch("island-toolbar-radius") &&
+                    base::StringToInt(island_cl.GetSwitchValueASCII(
+                                          "island-toolbar-radius"),
+                                      &parsed)) {
+      island_radius = std::clamp(parsed, 0, 24);
+    }
+    auto island = std::make_unique<CustomCornersBackground>(
         *this, *browser_view_,
         /*primary_color=*/CustomCornersBackground::ToolbarTheme(),
-        /*corner_color=*/CustomCornersBackground::FrameTheme()));
+        /*corner_color=*/CustomCornersBackground::FrameTheme(),
+        /*default_radius=*/island_radius);
+    CustomCornersBackground::Corners island_corners;
+    for (CornerOrientation corner :
+         {CornerOrientation::kTopLeading, CornerOrientation::kTopTrailing,
+          CornerOrientation::kBottomLeading,
+          CornerOrientation::kBottomTrailing}) {
+      island_corners[corner] = {
+          CustomCornersBackground::CornerType::kRoundedWithBackground,
+          island_radius};
+    }
+    island->SetCorners(island_corners);
+    SetBackground(std::move(island));
   } else if (display_mode_ == DisplayMode::kCustomTab) {
     custom_tab_bar_ =
         AddChildView(std::make_unique<CustomTabBarView>(browser_view_, this));
