+namespace {
+// Pref path and dictionary keys used by components/proxy_config.
+constexpr char kTorProxyPref[] = "proxy";
+constexpr char kTorProxyServer[] = "socks5://127.0.0.1:9050";
+
+void SetTorPrefs(PrefService* prefs, bool on) {
+  if (!on) {
+    prefs->ClearPref(kTorProxyPref);
+    prefs->SetString(prefs::kWebRTCIPHandlingPolicy,
+                     "default_public_interface_only");
+    return;
+  }
+  // SOCKS5 resolves hostnames on the proxy side, so DNS goes through Tor and
+  // .onion works. If Tor isn't running, requests fail rather than going direct.
+  base::DictValue proxy;
+  proxy.Set("mode", "fixed_servers");
+  proxy.Set("server", kTorProxyServer);
+  proxy.Set("bypass_list", "localhost;127.0.0.1;[::1]");
+  prefs->SetDict(kTorProxyPref, std::move(proxy));
+  // WebRTC UDP can bypass the proxy and reveal the real IP.
+  prefs->SetString(prefs::kWebRTCIPHandlingPolicy, "disable_non_proxied_udp");
+}
+
+void CloseConnections(Profile* profile) {
+  profile->GetDefaultStoragePartition()->GetNetworkContext()
+      ->CloseAllConnections(base::DoNothing());
+}
+}  // namespace
+
+// True when |profile|'s own prefs (including anything inherited by an
+// incognito profile) route through Tor.
+bool IsTorEnabled(Profile* profile) {
+  const base::DictValue& proxy = profile->GetPrefs()->GetDict(kTorProxyPref);
+  const std::string* server = proxy.FindString("server");
+  return server && *server == kTorProxyServer;
+}
+
+void ToggleTor(Profile* profile) {
+  // The global toggle lives on the regular profile; incognito windows inherit
+  // it. Tor windows have their own setting and are unaffected.
+  Profile* original = profile->GetOriginalProfile();
+  SetTorPrefs(original->GetPrefs(), !IsTorEnabled(original));
+}
+
+void NewTorWindow(Profile* profile) {
+  Profile* tor_profile = profile->GetOriginalProfile()->GetOffTheRecordProfile(
+      Profile::OTRProfileID::CreateUnique("Tor::Window"),
+      /*create_if_needed=*/true);
+  SetTorPrefs(tor_profile->GetPrefs(), true);
+  OpenEmptyWindow(tor_profile, /*should_trigger_session_restore=*/false);
+}
+
+void NewTorIdentity(Profile* profile) {
+  base::ThreadPool::PostTask(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN},
+      base::BindOnce([] {
+        const base::FilePath helper =
+            base::GetHomeDir().Append(".local/bin/tor-newnym");
+        if (!base::PathExists(helper)) {
+          LOG(WARNING) << "New Tor identity: " << helper << " not found";
+          return;
+        }
+        base::LaunchProcess(base::CommandLine(helper), base::LaunchOptions());
+      }));
+  Profile* original = profile->GetOriginalProfile();
+  CloseConnections(original);
+  for (Profile* otr : original->GetAllOffTheRecordProfiles()) {
+    CloseConnections(otr);
+  }
+}
+
 void CloseWindow(BrowserWindowInterface* browser) {
   base::RecordAction(UserMetricsAction("CloseWindow"));
   browser->GetWindow()->Close();
