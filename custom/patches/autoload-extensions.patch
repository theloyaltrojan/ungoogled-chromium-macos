# Load every unpacked extension in '<user data dir>/Autoload Extensions' at
# startup (symlinks allowed), so personal extensions need no rebuild or Load unpacked.
# They load without developer mode too, which new profiles (qubes) start without.
diff --git a/chrome/browser/extensions/extension_service.cc b/chrome/browser/extensions/extension_service.cc
