+namespace {
+// [custom] Extensions in "<user data dir>/Autoload Extensions", or symlinked
+// from there, were put there on purpose, so they load without developer mode.
+// A new profile (like a qube) starts with developer mode off, and that
+// setting is tamper-protected, so it can't be preset.
+bool IsAutoloadExtensionPath(const base::FilePath& user_data_dir,
+                             const base::FilePath& path) {
+  const base::FilePath dir =
+      user_data_dir.Append(FILE_PATH_LITERAL("Autoload Extensions"));
+  if (dir.IsParent(path)) {
+    return true;
+  }
+  base::FileEnumerator e(
+      dir, /*recursive=*/false,
+      base::FileEnumerator::DIRECTORIES | base::FileEnumerator::FILES);
+  for (base::FilePath entry = e.Next(); !entry.empty(); entry = e.Next()) {
+    if (base::MakeAbsoluteFilePath(entry) == path) {
+      return true;
+    }
+  }
+  return false;
+}
